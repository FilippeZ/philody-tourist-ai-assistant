# =============================================================================
# Philody AI Tourist Assistant - Production Configuration (.env)
# =============================================================================

# -----------------------------------------------------------------------------
# Cloud LLM Configuration (NVIDIA Nemotron-3-Ultra via Ollama API)
# STRICT ENFORCEMENT: Deterministic fallback is permanently disabled.
# If the Cloud LLM call fails, times out, or credentials are missing,
# the system strictly returns HTTP 503: 'Cloud LLM is currently unavailable.'
# -----------------------------------------------------------------------------
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=your_ollama_or_cloud_api_key_here
OLLAMA_MODEL=nemotron-3-ultra:253b

# OpenAI-Compatible Proxy / Ingestion Aliases (Optional / Cloud Gateway)
OPENAI_API_KEY=your_ollama_or_cloud_api_key_here
OPENAI_BASE_URL=https://ollama.com/v1
LLM_MODEL=nemotron-3-ultra:253b

# -----------------------------------------------------------------------------
# Strict Live Weather Tool (OpenWeatherMap API: required, no mock fallback)
# -----------------------------------------------------------------------------
OPENWEATHER_API_KEY=your_openweather_api_key_here

# -----------------------------------------------------------------------------
# Observability & Production SRE
# -----------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
RATE_LIMIT_PER_MINUTE=120
PROMETHEUS_METRICS_ENABLED=true
